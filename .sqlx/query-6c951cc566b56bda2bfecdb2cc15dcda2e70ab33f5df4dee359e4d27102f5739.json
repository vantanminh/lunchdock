{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.id, g.name, g.template, g.scopes, g.created_at, g.last_used_at, c.client_name\n        FROM mcp_grants g\n        JOIN oauth_clients c ON c.client_id = g.client_id\n        WHERE g.revoked_at IS NULL\n        ORDER BY g.created_at DESC\n        LIMIT 200\n        ",
