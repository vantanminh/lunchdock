{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id AS service_id, s.name, s.spec, s.server_id, s.current_container_id,\n               sv.kind AS server_kind\n        FROM deployments d\n        JOIN services s ON s.id = d.service_id\n        JOIN servers sv ON sv.id = s.server_id\n        WHERE d.id = $1\n        ",
