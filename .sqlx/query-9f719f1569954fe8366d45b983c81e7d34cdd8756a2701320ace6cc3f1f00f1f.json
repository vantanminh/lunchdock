  "query": "\n        UPDATE services\n        SET spec = COALESCE($2, spec),\n            server_id = COALESCE($3, server_id),\n            updated_at = now()\n        WHERE id = $1\n        RETURNING id, environment_id, server_id, name, kind, status, spec, created_at\n        ",
