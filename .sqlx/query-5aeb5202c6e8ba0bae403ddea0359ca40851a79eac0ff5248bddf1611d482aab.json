{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.slug, d.name, r.slug AS \"rank?\", r.level AS \"level?\"\n        FROM access_memberships m\n        JOIN access_departments d ON d.id = m.department_id\n        LEFT JOIN access_ranks r ON r.id = m.rank_id\n        WHERE m.identity_id = $1\n        ORDER BY d.slug\n        ",
