{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, service_id, status, trigger, image_ref, error,\n               right(logs, 200000) AS \"logs!\", length(logs) > 200000 AS \"logs_truncated!\",\n               started_at, finished_at, created_at\n        FROM deployments\n        WHERE service_id = $1\n        ORDER BY created_at DESC\n        LIMIT 50\n        ",
