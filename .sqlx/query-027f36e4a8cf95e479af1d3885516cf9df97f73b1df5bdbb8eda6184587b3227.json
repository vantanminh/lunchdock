  "query": "\n        SELECT DISTINCT d.host, d.ssl_mode, s.public_ip AS \"public_ip?\"\n        FROM domains d\n        JOIN services sv ON sv.id = d.service_id\n        JOIN servers s ON s.id = sv.server_id\n        WHERE NOT d.is_preview\n        ",
