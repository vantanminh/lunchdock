{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT q.id, q.deployment_id, q.status, q.cancel_requested, q.created_at\n        FROM build_queue q\n        JOIN deployments d ON d.id = q.deployment_id\n        WHERE d.service_id = $1\n        ORDER BY q.created_at DESC\n        LIMIT 50\n        ",
