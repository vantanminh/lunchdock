  "query": "\n        SELECT id, name, kind, environment_id, server_id, spec\n        FROM services\n        WHERE kind IN ('application', 'compose')\n          AND spec -> 'git' ->> 'provider_id' = $1\n          AND COALESCE(spec ->> 'preview_pull_requests', 'false') = 'true'\n        ",
