  "query": "\n        UPDATE servers\n        SET status = 'online',\n            docker_version = $2,\n            os_info = $3,\n            cpu_count = $4,\n            memory_bytes = $5,\n            last_heartbeat_at = now(),\n            updated_at = now()\n        WHERE id = $1\n        RETURNING id, name, kind, status, public_ip, description, agent_version, docker_version,\n                  os_info, cpu_count, memory_bytes, last_heartbeat_at, created_at\n        ",
