  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.user_id, t.scopes, t.expires_at, u.email, u.display_name, u.role, u.totp_enabled, u.is_owner\n        FROM api_tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token_hash = $1\n        ",
