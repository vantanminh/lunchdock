  "query": "\n        SELECT id, job_id, kind, trigger, status, started_at, finished_at, size_bytes, checksum,\n               object_keys, destination_ids, meta, logs, error\n        FROM backup_runs\n        WHERE job_id = $1\n        ORDER BY created_at DESC\n        LIMIT $2\n        ",
