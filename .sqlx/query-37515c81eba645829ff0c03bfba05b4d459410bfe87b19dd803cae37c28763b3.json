{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.user_id, s.csrf_token, s.expires_at, u.email, u.display_name, u.role, u.totp_enabled, u.is_owner\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1\n        ",
